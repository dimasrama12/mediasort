{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaSort",
  "version": "0.1.0",
  "identifier": "com.dimasrama.mediasort",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaSort",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Photography",
    "publisher": "dimasrama",
    "copyright": "© 2026 dimasrama",
    "shortDescription": "Fast local photo & video sorter",
    "longDescription": "MediaSort is a fast, offline desktop app for reviewing, grouping, renaming, and sorting large photo and video collections into target folders.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
